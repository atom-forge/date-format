{
	"name": "@atom-forge/date-format",
	"version": "0.1.6",
	"description": "Lightweight, token-based date formatting utility using Intl.DateTimeFormat",
	"keywords": [
		"date",
		"format",
		"intl",
		"typescript"
	],
	"author": {
		"name": "Gergely Laborci",
		"url": "https://github.com/laborci"
	},
	"license": "MIT",
	"type": "module",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		}
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/atom-forge/date-format.git"
	},
	"files": [
		"dist",
		"CHANGELOG.md",
		"README-AI.md",
		"docs"
	],
	"scripts": {
		"build": "tsc",
		"test": "npm run build && node --test test/*.test.js",
		"prepublishOnly": "npm test",
		"pub-check": "ship-it check",
		"pub": "ship-it"
	},
	"ship": {
		"verify": [
			"npm test",
			"npm pack --dry-run --ignore-scripts"
		]
	},
	"devDependencies": {
		"@atom-forge/ship": "file:../ship",
		"@types/node": "^25.3.1",
		"typescript": "^5.0.0"
	}
}
